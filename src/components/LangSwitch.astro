---
/**
 * Language dropdown menu with SVG flags.
 * Defaults to FR. Opens on click.
 */
---

<div class="relative" id="lang-dropdown-container">
  <button
    type="button"
    id="lang-switch-btn"
    aria-label="Select language"
    aria-expanded="false"
    class="flex cursor-pointer items-center gap-2 rounded-full border border-neutral/30 bg-white/[0.05] px-3 py-1.5 text-xs font-medium text-white backdrop-blur-sm transition-all duration-300 hover:border-primary/50 hover:bg-white/[0.08]"
  >
    <div
      id="flag-display"
      class="pointer-events-none flex h-3 w-4 items-center justify-center overflow-hidden rounded-[2px]"
    >
      <!-- Default FR SVG -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 3 2"
        class="h-full w-full object-cover"
        ><rect width="1" height="2" fill="#0055A4"></rect><rect
          x="1"
          width="1"
          height="2"
          fill="#FFFFFF"></rect><rect x="2" width="1" height="2" fill="#EF4135"
        ></rect></svg
      >
    </div>
    <span id="lang-label" class="pointer-events-none tracking-wide uppercase">FR</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none text-neutral transition-transform duration-200"
      id="lang-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg
    >
  </button>

  <ul
    id="lang-menu"
    class="invisible absolute top-[calc(100%+0.5rem)] right-0 z-50 w-32 translate-y-2 rounded-xl border border-neutral/30 bg-[#111827]/95 p-1.5 opacity-0 shadow-xl shadow-black/50 backdrop-blur-md transition-all duration-200"
  >
    <li>
      <button
        class="lang-option flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white"
        data-lang="fr"
      >
        <div class="pointer-events-none flex items-center gap-2">
          <div
            class="flex h-3 w-4 items-center justify-center overflow-hidden rounded-[2px] shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 3 2"
              class="h-full w-full object-cover"
              ><rect width="1" height="2" fill="#0055A4"></rect><rect
                x="1"
                width="1"
                height="2"
                fill="#FFFFFF"></rect><rect
                x="2"
                width="1"
                height="2"
                fill="#EF4135"></rect></svg
            >
          </div>
          <span>Français</span>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="pointer-events-none text-primary opacity-0 transition-opacity"
          data-check="fr"><polyline points="20 6 9 17 4 12"></polyline></svg
        >
      </button>
    </li>
    <li>
      <button
        class="lang-option flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg px-2.5 py-2 text-xs font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white"
        data-lang="en"
      >
        <div class="pointer-events-none flex items-center gap-2">
          <div
            class="flex h-3 w-4 items-center justify-center overflow-hidden rounded-[2px] shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 60 30"
              class="h-full w-full object-cover"
              ><clipPath id="s"><path d="M0,0 v30 h60 v-30 z"></path></clipPath
              ><clipPath id="t"
                ><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"
                ></path></clipPath
              ><g clip-path="url(#s)"
                ><path d="M0,0 v30 h60 v-30 z" fill="#012169"></path><path
                  d="M0,0 L60,30 M60,0 L0,30"
                  stroke="#fff"
                  stroke-width="6"></path><path
                  d="M0,0 L60,30 M60,0 L0,30"
                  clip-path="url(#t)"
                  stroke="#C8102E"
                  stroke-width="4"></path><path
                  d="M30,0 v30 M0,15 h60"
                  stroke="#fff"
                  stroke-width="10"></path><path
                  d="M30,0 v30 M0,15 h60"
                  stroke="#C8102E"
                  stroke-width="6"></path></g
              ></svg
            >
          </div>
          <span>English</span>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="pointer-events-none text-primary opacity-0 transition-opacity"
          data-check="en"><polyline points="20 6 9 17 4 12"></polyline></svg
        >
      </button>
    </li>
  </ul>
</div>

<script>
  import { translations, defaultLocale } from "../config/i18n";
  import type { Locale } from "../config/i18n";

  function initLangDropdown() {
    const toggleBtn = document.getElementById("lang-switch-btn");
    const menu = document.getElementById("lang-menu");
    const chevron = document.getElementById("lang-chevron");
    const flagDisplay = document.getElementById("flag-display");
    const langLabel = document.getElementById("lang-label");
    const langOptions = document.querySelectorAll<HTMLButtonElement>(".lang-option");

    if (!toggleBtn || !menu) return;

    // Prevent duplicate event listeners
    if (toggleBtn.hasAttribute('data-dropdown-initialized')) return;
    toggleBtn.setAttribute('data-dropdown-initialized', 'true');

    let isOpen = false;

    const svgs: Record<Locale, string> = {
      fr: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 3 2" class="h-full w-full object-cover"><rect width="1" height="2" fill="#0055A4"></rect><rect x="1" width="1" height="2" fill="#FFFFFF"></rect><rect x="2" width="1" height="2" fill="#EF4135"></rect></svg>`,
      en: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" class="h-full w-full object-cover"><clipPath id="s_js"><path d="M0,0 v30 h60 v-30 z"/></clipPath><clipPath id="t_js"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><g clip-path="url(#s_js)"><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#t_js)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></g></svg>`,
    };

    const labels: Record<Locale, string> = { fr: "FR", en: "EN" };

    // Validate stored language
    let savedLang = localStorage.getItem("lang");
    if (savedLang !== "fr" && savedLang !== "en") {
      savedLang = defaultLocale;
    }
    
    let currentLang: Locale = savedLang as Locale;

    function openMenu() {
      isOpen = true;
      menu?.classList.remove("opacity-0", "invisible", "translate-y-2");
      menu?.classList.add("opacity-100", "visible", "translate-y-0");
      chevron?.classList.add("rotate-180");
      toggleBtn?.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      isOpen = false;
      menu?.classList.add("opacity-0", "invisible", "translate-y-2");
      menu?.classList.remove("opacity-100", "visible", "translate-y-0");
      chevron?.classList.remove("rotate-180");
      toggleBtn?.setAttribute("aria-expanded", "false");
    }

    toggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isOpen) closeMenu();
      else openMenu();
    });

    document.addEventListener("click", (e) => {
      const container = document.getElementById("lang-dropdown-container");
      if (isOpen && container && !container.contains(e.target as Node)) {
        closeMenu();
      }
    });

    function applyLanguage(lang: Locale) {
      try {
        currentLang = lang;
        localStorage.setItem("lang", lang);
        document.documentElement.setAttribute("lang", lang);

        if (flagDisplay) flagDisplay.innerHTML = svgs[lang];
        if (langLabel) langLabel.textContent = labels[lang];

        langOptions.forEach((btn) => {
          const btnLang = btn.dataset.lang;
          const checkIcon = btn.querySelector(`[data-check="${btnLang}"]`);

          if (btnLang === lang) {
            btn.classList.add("bg-white/[0.15]", "text-white");
            btn.classList.remove("text-white/70");
            if (checkIcon) checkIcon.classList.remove("opacity-0");
          } else {
            btn.classList.remove("bg-white/[0.15]", "text-white");
            btn.classList.add("text-white/70");
            if (checkIcon) checkIcon.classList.add("opacity-0");
          }
        });

        const t = translations[lang];
        if (!t) return;

        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const key = el.dataset.i18n;
          if (key && t[key] !== undefined) {
            el.innerHTML = t[key];
          }
        });
      } catch (err) {
        console.error("Error applying language:", err);
      }
    }

    langOptions.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedLang = btn.dataset.lang as Locale;
        if (selectedLang && selectedLang !== currentLang) {
          applyLanguage(selectedLang);
        }
        closeMenu();
      });
    });

    applyLanguage(currentLang);
  }

  document.addEventListener('DOMContentLoaded', initLangDropdown);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initLangDropdown();
  }
</script>
