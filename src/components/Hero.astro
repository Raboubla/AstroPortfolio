---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, email } = Astro.props;
---

<section class="py-24 md:py-32" id="#hero">
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    <span data-i18n="hero.specialty"
      >Développeur Fullstack Java / TypeScript</span
    >
  </p>
  <p class="mb-16 text-base font-normal text-neutral md:text-lg">
    <span data-i18n="hero.summary"
      >Salut, je suis Herimbola — Bienvenue ! Ingénieur logiciel Fullstack et
      étudiant en Master, je combine une expertise backend robuste (Java/Spring
      Boot, NestJS) et la maîtrise d'écosystèmes frontend modernes (React,
      Angular, Astro). Passionné par l'architecture logicielle et la sécurité,
      je conçois des applications web et mobiles performantes et sécurisées.
      Addict au gaming et au dev — je construis, je casse, j'apprends et je
      grandis.</span
    >
  </p>

  <div class="flex flex-wrap gap-4">
    <a
      class="inline-flex items-center rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff] transition-all duration-300 hover:bg-primary/85 hover:shadow-lg hover:shadow-primary/25"
      href={`mailto:${email}`}><span data-i18n="hero.cta">Me contacter</span></a
    >
    <a
      class="group inline-flex items-center gap-2 rounded-full border border-primary/50 px-8 py-5 text-sm leading-5 font-medium text-primary transition-all duration-300 hover:border-primary hover:bg-primary/10 hover:shadow-lg hover:shadow-primary/15"
      href="/Cvv5.pdf"
      download="Herimbola_RAZANAKOTO_CV.pdf"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-300 group-hover:translate-y-0.5"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span data-i18n="hero.download">Télécharger le CV</span>
    </a>
  </div>
</section>
