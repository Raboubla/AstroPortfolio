---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Expériences professionnelles" href="experience" i18nKey="section.experience">
  {
    experience.map(({ company, position, startDate, endDate, summary }, expIdx) => (
      <div class="mb-10">
        <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white">
          {company}
        </h3>
        <div class="flex flex-col items-start pb-5">
          <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
            <span data-i18n={`exp.${expIdx}.position`}>{position}</span>
          </h4>
          <span class="pb-[2px] text-sm text-white/70">
            <span data-i18n={`exp.${expIdx}.startDate`}>{startDate}</span> — <span data-i18n={`exp.${expIdx}.endDate`}>{endDate}</span>
          </span>
        </div>
        {Array.isArray(summary) ? (
          <ul class="list-none">
            {summary.map((log, logIdx) => (
              <li class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                <span data-i18n={`exp.${expIdx}.summary.${logIdx}`}>{log}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-neutral"><span data-i18n={`exp.${expIdx}.summary.0`}>{summary}</span></p>
        )}
      </div>
    ))
  }
</Section>
