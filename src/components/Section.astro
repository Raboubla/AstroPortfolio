---
interface Props {
  text: string;
  href: string;
  i18nKey?: string;
}

const { text, href, i18nKey } = Astro.props;
---

<section id={href} class="animate-on-scroll py-24">
  <h2
    class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
    {...(i18nKey ? { "data-i18n": i18nKey } : {})}
  >
    {text}
  </h2>
  <slot />
</section>
