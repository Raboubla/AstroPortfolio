---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectCategory } from "@types";

interface Props {
  projects: ProjectCategory[];
}

const categories = Astro.props.projects;
---

<Section text="Projets réalisés" href="projects" i18nKey="section.projects">
  {
    categories.map((category, catIndex) => (
      <div class="mb-16">
        <h3 class="mb-8 font-serif text-2xl font-bold text-white md:text-3xl border-l-4 border-primary pl-4">
          {category.title}
        </h3>
        <div>
          {category.projects.map(({ name, summary, image, linkPreview, linkSource, i18nKey }, index) => {
            const top = 98 + index * 40;
            return (
              <div
                style={`top: ${top}px;`}
                class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
              >
                <div class="bg-difu relative z-[1] flex flex-col sm:grid sm:grid-cols-2 w-full h-auto min-h-[580px] md:min-h-[24rem] rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-['']">
                  <div class="px-6 py-8 sm:px-8 sm:py-12 flex flex-col justify-center">
                    <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                      {name}
                    </h3>
                    <p class="text-base text-neutral">
                      <span data-i18n={i18nKey}>{summary}</span>
                    </p>
                    <div class="flex gap-5 pt-8 mt-auto text-white">
                      {linkSource && (
                        <a
                          href={linkSource}
                          target="_blank"
                          class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                        >
                          <span data-i18n="projects.source">Source</span>
                        </a>
                      )}
                      {linkPreview && (
                        <a
                          href={linkPreview}
                          target="_blank"
                          class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                        >
                          <span data-i18n="projects.preview">Aperçu</span>
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="flex items-end justify-end overflow-hidden pt-6 sm:pt-0">
                    {image ? (
                      typeof image === "string" ? (
                        <img
                          class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-left-top sm:h-[85%] sm:w-full"
                          src={image}
                          alt={name}
                          width="736"
                          height="483"
                        />
                      ) : (
                        <Image
                          class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-left-top sm:h-[85%] sm:w-full"
                          src={image}
                          alt={name}
                          width="736"
                          height="483"
                        />
                      )
                    ) : (
                      <div class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl bg-neutral/10 flex items-center justify-center sm:h-[85%] sm:w-full border border-neutral/20">
                        <span class="text-neutral/50 text-xl font-serif">Image à venir</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))
  }
</Section>
